# ==============================================================
# GIKI FOR WOMEN - Digital Exit Assistance Configuration
# Academic Semester Project Prototype
# ==============================================================

# Database Configuration (SQLite development database)
DATABASE_URL="sqlite:///./app.db"

# JWT Authentication
JWT_SECRET="giki-women-jwt-secret-key-super-secure-min-32-chars-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# Gate Pass Cryptographic Signature (HMAC-SHA256)
HMAC_SECRET="giki-gatepass-hmac-sha256-digital-signature-key-2026"

# Environment
APP_ENV="development"
PORT="3000"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Meta WhatsApp Business Cloud API Configuration
# In production, register on https://developers.facebook.com and configure WhatsApp Business API
WHATSAPP_ACCESS_TOKEN="your_meta_whatsapp_cloud_api_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_APP_SECRET="your_meta_app_secret_for_webhook_hmac_sha256"
WHATSAPP_VERIFY_TOKEN="giki_women_whatsapp_verify_token_2026"
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_NAME="giki_parent_exit_consent"

# Simulation Mode: Set to "true" for testing without live WhatsApp API credentials
# In development simulation mode:
# - An interactive simulation panel allows simulating YES/NO WhatsApp replies
# - Messages are marked explicitly as simulated
# - Meta webhook verification and HMAC-SHA256 signatures are still fully validated
WHATSAPP_SIMULATION_MODE="true"

# Gemini API Key (if needed by platform)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
